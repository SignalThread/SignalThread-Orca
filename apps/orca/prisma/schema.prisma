  SignageSign      SignageSign      @relation(fields: [signId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([signId, kind, createdAt])
}

model SignageChangeImpact {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  signId           String              @db.Uuid
  sourceType       SignageImpactSource
  sourceId         String
  affectedFields   String[]
  fingerprint      String
  sourceSnapshot   Json?
  reviewedAt       DateTime?
  reviewedByUserId String?             @db.Uuid
  createdAt        DateTime            @default(now())
  SignageSign      SignageSign         @relation(fields: [signId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([signId, fingerprint])
}

model SignageChecklistItem {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId           String    @db.Uuid
  ownerUserId       String?   @db.Uuid
  key               String
  label             String
  isComplete        Boolean   @default(false)
  completedByUserId String?   @db.Uuid
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  Event             Event     @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([eventId, key])
  @@unique([eventId, ownerUserId, key])
}

model SignageIssue {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  signId                 String             @db.Uuid
  type                   SignageIssueType
  status                 SignageIssueStatus @default(OPEN)
  description            String?
  reportedByUserId       String?            @db.Uuid
  resolvedByUserId       String?            @db.Uuid
  createdAt              DateTime           @default(now())
  resolvedAt             DateTime?
  responsibleOwnerUserId String?            @db.Uuid
  replacementNeeded      Boolean            @default(false)
  SignageSign            SignageSign        @relation(fields: [signId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([responsibleOwnerUserId, status])
}

model SignageRouteOrder {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  signId              String      @db.Uuid
  routeKey            String
  routeOrder          Int
  stopOrder           Int
  assignedOwnerUserId String?     @db.Uuid
  createdAt           DateTime    @default(now())
  updatedAt           DateTime
  SignageSign         SignageSign @relation(fields: [signId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([signId, routeKey])
}

model SignageSign {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId                  String                    @db.Uuid
  sessionId                String?                   @db.Uuid
  roomId                   String?                   @db.Uuid
  budgetLineItemId         String?                   @db.Uuid
  name                     String
  signType                 SignageSignType
  workflowState            SignageWorkflowState      @default(NEEDS_INFO)
  lastNormalState          SignageWorkflowState      @default(NEEDS_INFO)
  priority                 SignagePriority           @default(NORMAL)
  notNeededReason          String?
  blockedReason            String?
  blockingOwnerUserId      String?                   @db.Uuid
  displayCopy              String?
  language                 String?
  qrDestination            String?
  accessibilityNotes       String?
  width                    Decimal?                  @db.Decimal(10, 2)
  height                   Decimal?                  @db.Decimal(10, 2)
  dimensionUnit            SignageDimensionUnit      @default(INCHES)
  orientation              SignageOrientation?
  material                 SignageMaterial?
  sidedness                SignageSidedness          @default(SINGLE)
  quantity                 Int                       @default(1)
  finishing                String?
  printInstructions        String?
  logoRequirement          SignageLogoRequirement    @default(TO_BE_DECIDED)
  brandingNotes            String?
  vendorName               String?
  designOwnerUserId        String?                   @db.Uuid
  installOwnerUserId       String?                   @db.Uuid
  approverUserId           String?                   @db.Uuid
  productionDeadline       DateTime?
  neededBy                 DateTime?
  venueName                String?
  floorName                String?
  locationName             String?
  exactPlacement           String?
  installWindowStart       DateTime?
  installWindowEnd         DateTime?
  removalWindowStart       DateTime?
  removalWindowEnd         DateTime?
  placementNotes           String?
  referenceImageUrl        String?
  installState             SignageInstallState       @default(NOT_SCHEDULED)
  installedByUserId        String?                   @db.Uuid
  installedAt              DateTime?
  issueStatus              SignageIssueStatus        @default(NONE)
  templateKey              String?
  templateProvenance       Json?
  sourceProvenance         Json?
  revision                 Int                       @default(1)
  createdByUserId          String?                   @db.Uuid
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime
  speakerId                String?                   @db.Uuid
  fnbCatalogItemId         String?                   @db.Uuid
  linkedSponsorName        String?
  productionFormat         String?
  designerUserId           String?                   @db.Uuid
  installConfirmationNotes String?
  installProofStatus       SignageInstallProofStatus @default(NOT_RECORDED)
  requiredLogos            String[]                  @default([])
  brandingDecision         SignageBrandingDecision   @default(NEEDS_DECISION)
  SignageApproval          SignageApproval[]
  SignageAsset             SignageAsset[]
  SignageChangeImpact      SignageChangeImpact[]
  SignageIssue             SignageIssue[]
  SignageRouteOrder        SignageRouteOrder[]
  BudgetLineItem           BudgetLineItem?           @relation(fields: [budgetLineItemId], references: [id], onUpdate: NoAction)
  Event                    Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Room                     Room?                     @relation(fields: [roomId], references: [id], onUpdate: NoAction)
  MatrixRow                MatrixRow?                @relation(fields: [sessionId], references: [id], onUpdate: NoAction)
  SignageSignSession       SignageSignSession[]

  @@index([eventId, fnbCatalogItemId])
  @@index([eventId, installOwnerUserId, installWindowStart])
  @@index([eventId, roomId])
  @@index([eventId, sessionId])
  @@index([eventId, speakerId])
  @@index([eventId, vendorName])
  @@index([eventId, workflowState])
}

model SignageSignSession {
  signId      String      @db.Uuid
  sessionId   String      @db.Uuid
  linkedAt    DateTime    @default(now())
  MatrixRow   MatrixRow   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  SignageSign SignageSign @relation(fields: [signId], references: [id], onDelete: Cascade)

  @@id([signId, sessionId])
  @@index([sessionId, signId])
}

model SupplyAllocationAudit {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId                 String                  @db.Uuid
  allocationId            String                  @db.Uuid
  actorUserId             String?                 @db.Uuid
  action                  String
  changes                 Json
  createdAt               DateTime                @default(now())
  User                    User?                   @relation(fields: [actorUserId], references: [id], onUpdate: NoAction)
  SessionSupplyAllocation SessionSupplyAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Event                   Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([allocationId, createdAt])
  @@index([eventId, createdAt])
}

model SupplyDependency {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  allocationId            String                  @db.Uuid
  type                    SupplyDependencyType
  linkedSourceRecordId    String?                 @db.Uuid
  label                   String
  blocking                Boolean                 @default(false)
  resolvedAt              DateTime?
  resolutionNotes         String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @default(now())
  SessionSupplyAllocation SessionSupplyAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([allocationId, blocking, resolvedAt])
}

model SupplyItem {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId                 String                    @db.Uuid
  name                    String
  category                String
  unit                    String                    @default("each")
  committedQuantity       Int?
  defaultSource           String?
  defaultOwner            String?
  notes                   String?
  externalReference       String?
  revision                Int                       @default(1)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now())
  SessionSupplyAllocation SessionSupplyAllocation[]
  Event                   Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  SupplyTemplateItem      SupplyTemplateItem[]

  @@unique([eventId, id])
  @@unique([eventId, name])
  @@index([eventId, category])
}

model SupplyTemplate {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId            String?              @db.Uuid
  key                String               @unique(map: "SupplyTemplate_system_key_key", where: raw("\"isSystem\""))
  name               String
  triggerType        String
  triggerMeta        Json?
  isSystem           Boolean              @default(false)
  active             Boolean              @default(true)
  revision           Int                  @default(1)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now())
  Event              Event?               @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  SupplyTemplateItem SupplyTemplateItem[]

  @@unique([eventId, key])
  @@index([eventId, active])
  @@index([isSystem, triggerType])
}

model SupplyTemplateItem {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId     String             @db.Uuid
  supplyItemId   String?            @db.Uuid
  name           String
  category       String
  unit           String             @default("each")
  rationale      String
  quantityRule   SupplyQuantityRule
  quantityFactor Decimal?           @db.Decimal(12, 4)
  fixedQuantity  Int?
  defaultSource  String?
  defaultOwner   String?
  sortOrder      Int                @default(0)
  active         Boolean            @default(true)
  SupplyItem     SupplyItem?        @relation(fields: [supplyItemId], references: [id], onUpdate: NoAction)
  SupplyTemplate SupplyTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([templateId, name])
  @@index([templateId, sortOrder])
}

// ============================================================================
// Attendee lifecycle — event participation layer on top of Event Directory.
// EventDirectoryPerson = WHO the person is (canonical identity).
// EventAttendee        = HOW this person participates in this event.
// EventRegistrationRecord = registration/badge/order/provider state (when real).
// Provider-aware, not provider-specific. New, additive models.
// ============================================================================

model EventAttendee {
  id                  String                           @id @default(uuid()) @db.Uuid
  eventId             String                           @db.Uuid
  directoryPersonId   String                           @unique @db.Uuid
  attendanceStatus    EventAttendeeAttendanceStatus    @default(EXPECTED)
  registrationStatus  EventAttendeeRegistrationStatus  @default(NOT_REGISTERED)
  registrationType    String?                          @db.Text
  badgeType           String?                          @db.Text
  ticketType          String?                          @db.Text
  source              EventAttendeeSource              @default(MANUAL)
  syncStatus          EventAttendeeSyncStatus          @default(LOCAL_ONLY)
  portalAccessStatus  EventAttendeePortalStatus        @default(NOT_INVITED)
  notes               String?                          @db.Text
  registeredAt        DateTime?
  waitlistedAt        DateTime?
  cancelledAt         DateTime?
  checkedInAt         DateTime?
  lastSyncedAt        DateTime?
  createdByUserId     String?                          @db.Uuid
  importedByUserId    String?                          @db.Uuid
  syncedByUserId      String?                          @db.Uuid
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt
  event               Event                            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person              EventDirectoryPerson             @relation(fields: [directoryPersonId], references: [id], onDelete: Cascade)
  registrationRecords EventRegistrationRecord[]
  externalIdentities  EventExternalIdentity[]
  seatingAttendee     SeatingAttendee?
  sessionEnrollments  EventAttendeeSessionEnrollment[]

  @@index([eventId, registrationStatus])
  @@index([eventId, attendanceStatus])
  @@index([eventId, source])
  @@index([eventId, syncStatus])
  @@index([directoryPersonId])
}

model EventRegistrationRecord {
  id                     String                           @id @default(uuid()) @db.Uuid
  eventId                String                           @db.Uuid
  attendeeId             String                           @db.Uuid
  directoryPersonId      String                           @db.Uuid
  provider               String                           @default("manual") @db.Text
  externalRegistrationId String?                          @db.Text
  externalPersonId       String?                          @db.Text
  externalOrderId        String?                          @db.Text
  registrationStatus     EventAttendeeRegistrationStatus  @default(REGISTERED)
  registrationType       String?                          @db.Text
  ticketType             String?                          @db.Text
  badgeType              String?                          @db.Text
  paymentStatus          String?                          @db.Text
  syncStatus             EventAttendeeSyncStatus          @default(LOCAL_ONLY)
  writebackStatus        EventRegistrationWritebackStatus @default(NOT_APPLICABLE)
  registeredAt           DateTime?
  cancelledAt            DateTime?
  lastSyncedAt           DateTime?
  providerUpdatedAt      DateTime?
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  event                  Event                            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee               EventAttendee                    @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  person                 EventDirectoryPerson             @relation(fields: [directoryPersonId], references: [id], onDelete: Cascade)
  sessionEnrollments     EventAttendeeSessionEnrollment[]

  @@unique([eventId, provider, externalRegistrationId])
  @@index([attendeeId])
  @@index([directoryPersonId])
  @@index([eventId, provider])
}

model EventAttendeeSessionEnrollment {
  id                            String                               @id @default(uuid()) @db.Uuid
  eventId                       String                               @db.Uuid
  attendeeId                    String                               @db.Uuid
  matrixRowId                   String                               @db.Uuid
  enrollmentStatus              EventAttendeeSessionEnrollmentStatus @default(REGISTERED)
  source                        EventAttendeeSessionEnrollmentSource @default(MANUAL)
  externalSessionRegistrationId String?                              @db.Text
  integrationConnectionId       String?                              @db.Uuid
  registrationRecordId          String?                              @db.Uuid
  waitlistedAt                  DateTime?
  cancelledAt                   DateTime?
  checkedInAt                   DateTime?
  createdByUserId               String?                              @db.Uuid
  updatedByUserId               String?                              @db.Uuid
  createdAt                     DateTime                             @default(now())
  updatedAt                     DateTime                             @updatedAt
  event                         Event                                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee                      EventAttendee                        @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  matrixRow                     MatrixRow                            @relation(fields: [matrixRowId], references: [id], onDelete: Cascade)
  integrationConnection         EventIntegrationConnection?          @relation(fields: [integrationConnectionId], references: [id], onDelete: SetNull)
  registrationRecord            EventRegistrationRecord?             @relation(fields: [registrationRecordId], references: [id], onDelete: SetNull)

  @@unique([eventId, attendeeId, matrixRowId], map: "EventAttendeeSessionEnrollment_event_attendee_session_key")
  @@unique([eventId, integrationConnectionId, externalSessionRegistrationId], map: "EventAttendeeSessionEnrollment_external_registration_key", where: raw("((\"integrationConnectionId\" IS NOT NULL) AND (\"externalSessionRegistrationId\" IS NOT NULL))"))
  @@index([eventId, attendeeId, enrollmentStatus], map: "EventAttendeeSessionEnrollment_event_attendee_status_idx")
  @@index([eventId, integrationConnectionId], map: "EventAttendeeSessionEnrollment_event_integrationConnection_idx")
  @@index([eventId, matrixRowId, enrollmentStatus], map: "EventAttendeeSessionEnrollment_event_matrix_status_idx")
  @@index([eventId, registrationRecordId], map: "EventAttendeeSessionEnrollment_event_registrationRecord_idx")
}


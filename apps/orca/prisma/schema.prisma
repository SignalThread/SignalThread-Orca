model EventActivity {
  id               String                 @id @default(uuid()) @db.Uuid
  eventId          String                 @db.Uuid
  // Actor identity. actorUserId is now nullable so system/integration/portal
  // actors can be recorded. actorLabel is a historical snapshot that stays
  // readable after the underlying user is renamed or removed.
  actorUserId      String?                @db.Uuid
  actorKind        EventActivityActorKind @default(USER)
  actorLabel       String?                @db.Text
  // Canonical audit taxonomy. module/actionType are nullable during writer
  // cutover; final non-null constraints wait until every writer is migrated.
  module           EventActivityModule?
  actionType       EventActivityAction?
  entityType       String?                @db.Text
  entityId         String?                @db.Text
  entityLabel      String?                @db.Text
  message          String                 @db.Text
  // Whitelisted, server-constructed field-level diffs. Never a full record dump.
  changes          Json?
  // Optional source-record identity used for event-scoped idempotent dedup.
  sourceRecordType String?                @db.Text
  sourceRecordId   String?                @db.Text
  // Legacy coarse enum, retained for backward compatibility with pre-cutover rows.
  type             EventActivityType?
  createdAt        DateTime               @default(now())
  event            Event                  @relation(fields: [eventId], references: [id])
  actorUser        User?                  @relation("EventActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  // Event-scoped deduplication: rows without source identity (NULLs) never collide.
  @@unique([eventId, sourceRecordType, sourceRecordId])
  @@index([eventId, createdAt, id])
  @@index([eventId, actorUserId, createdAt, id])
  @@index([eventId, module, createdAt, id])
  @@index([eventId, actionType, createdAt, id])
  @@index([actorUserId])
}


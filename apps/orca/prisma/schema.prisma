// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  // Six live unique indexes carry WHERE predicates. Without this preview feature Prisma
  // models them as plain unique indexes and silently drops the predicate.
  previewFeatures = ["partialIndexes"]
  engineType      = "library"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                 String               @id @default(uuid()) @db.Uuid
  name               String               @db.Text
  slug               String               @unique @db.Text
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  users              User[]
  memberships        Membership[]
  events             Event[]
  clients            Client[]
  documentTags       DocumentTag[]
  documents          Document[]
  copilotAuditLogs   CopilotAuditLog[]
  fnbParserFeedback  FnbParserFeedback[]
  tasks              Task[]
  eventImportIntents EventImportIntent[]
  eventImportResults EventImportResult[]
  agendaTerm         String?              @db.Text
  runOfShowTerm      String?              @db.Text
  matrixTerm         String?              @db.Text
  showFlowTerm       String?              @db.Text
  EventDashboardView EventDashboardView[]
}

model User {
  id                              String                      @id @default(uuid()) @db.Uuid
  orgId                           String                      @db.Uuid
  email                           String                      @unique @db.Text
  // Canonical SignalThread Platform Core user id. Additive and nullable during the
  // transition: rows are linked on first authenticated request or by the backfill script.
  // Once every row is linked, this becomes the sole identity join key and email stops
  // being an identity at all.
  platformUserId                  String?                     @unique @db.Uuid
  name                            String?                     @db.Text
  role                            UserRole
  createdAt                       DateTime                    @default(now())
  updatedAt                       DateTime                    @updatedAt
  organization                    Organization                @relation(fields: [orgId], references: [id])
  memberships                     Membership[]
  eventMemberships                EventMember[]
  createdEvents                   Event[]                     @relation("EventCreatedBy")
  ownedDeadlines                  Deadline[]                  @relation("DeadlineOwner")
  createdBudgetVersion            BudgetVersion[]             @relation("BudgetVersionCreatedBy")
  actedBudgetApprovals            BudgetApproval[]            @relation("BudgetApprovalActedBy")
  submittedBudgets                Budget[]                    @relation("BudgetSubmittedBy")
  approvedBudgets                 Budget[]                    @relation("BudgetApprovedBy")
  rejectedBudgets                 Budget[]                    @relation("BudgetRejectedBy")
  budgetActivities                BudgetActivity[]            @relation("BudgetActivityActor")
  submittedBudgetSubmissions      BudgetSubmission[]          @relation("BudgetSubmissionSubmittedBy")
  pulledBackBudgetSubmissions     BudgetSubmission[]          @relation("BudgetSubmissionPulledBackBy")
  budgetSubmissionRecipients      BudgetSubmissionRecipient[] @relation("BudgetSubmissionRecipientUser")
  eventActivities                 EventActivity[]             @relation("EventActivityActor")
  documentVersions                DocumentVersion[]           @relation("DocumentVersionUploadedBy")
  documentApprovals               DocumentApproval[]          @relation("DocumentApprovalActedBy")
  documentApprovalRecipients      DocumentApprovalRecipient[] @relation("DocumentApprovalRecipientUser")
  ownedTimelineItems              TimelineItem[]              @relation("TimelineItemOwner")
  timelineNotNeededDispositions   TimelineItem[]              @relation("TimelineItemNotNeededBy")
  copilotAuditLogs                CopilotAuditLog[]
  reviewedSpeakerSubmissions      SpeakerProfileSubmission[]  @relation("SpeakerSubmissionReviewedBy")
  uploadedSpeakerFiles            SpeakerFile[]               @relation("SpeakerFileUploadedBy")
  reviewedSpeakerFiles            SpeakerFile[]               @relation("SpeakerFileReviewedBy")
  createdSpeakerDocumentRequests  SpeakerDocumentRequest[]    @relation("SpeakerDocumentRequestCreatedBy")
  sentSpeakerMessages             SpeakerMessage[]            @relation("SpeakerMessageSenderUser")
  speakerInternalNotes            SpeakerInternalNote[]       @relation("SpeakerInternalNoteAuthor")
  triggeredSpeakerEmailLogs       SpeakerEmailLog[]           @relation("SpeakerEmailLogTriggeredBy")
  updatedSpeakerOnsiteInfos       SpeakerOnsiteInfo[]         @relation("SpeakerOnsiteInfoUpdatedBy")
  createdTasks                    Task[]                      @relation("TaskCreatedBy")
  completedTasks                  Task[]                      @relation("TaskCompletedBy")
  canceledTasks                   Task[]                      @relation("TaskCanceledBy")
  taskAssignments                 TaskAssignment[]            @relation("TaskAssignmentUser")
  assignedTasks                   TaskAssignment[]            @relation("TaskAssignmentAssignedBy")
  taskComments                    TaskComment[]               @relation("TaskCommentAuthor")
  taskActivity                    TaskActivity[]              @relation("TaskActivityActor")
  watchedTasks                    TaskWatcher[]               @relation("TaskWatcherUser")
  ownedMarketingPlans             MarketingPlan[]             @relation("MarketingPlanOwner")
  ownedMarketingCampaigns         MarketingCampaign[]         @relation("MarketingCampaignOwner")
  ownedMarketingEmailSends        MarketingEmailSend[]        @relation("MarketingEmailSendOwner")
  capturedMarketingKpiSnapshots   MarketingKpiSnapshot[]      @relation("MarketingKpiSnapshotCapturedBy")
  eventImportIntents              EventImportIntent[]         @relation("EventImportRequestedBy")
  eventImportResults              EventImportResult[]         @relation("EventImportResultRequestedBy")
  matrixImportBatches             MatrixImportBatch[]         @relation("MatrixImportRequestedBy")
  timelineImportBatches           TimelineImportBatch[]       @relation("TimelineImportRequestedBy")
  publishedSessionAgendas         SessionAgendaPublication[]  @relation("SessionAgendaPublishedBy")
  ownedFnbSourceMenus             EventFnbSourceMenu[]        @relation("FnbSourceMenuOwner")
  verifiedFnbSourceMenus          EventFnbSourceMenu[]        @relation("FnbSourceMenuVerifier")
  verifiedFnbCatalogItems         EventFnbCatalogItem[]       @relation("FnbCatalogItemVerifier")
  verifiedFnbCatalogModifications EventFnbCatalogItem[]       @relation("FnbCatalogItemModificationVerifier")

  SessionSupplyAllocation SessionSupplyAllocation[]
  SupplyAllocationAudit   SupplyAllocationAudit[]

  EventDashboardLayoutMigration EventDashboardLayoutMigration[]
  EventDashboardView            EventDashboardView[]
  EventDashboardViewPreference  EventDashboardViewPreference[]
  UserDashboardLayout           UserDashboardLayout[]

  @@index([orgId])
  @@index([platformUserId])
}

model Membership {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @db.Uuid
  userId       String       @db.Uuid
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([orgId, userId])
  @@index([userId])
}

model Notification {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @db.Uuid
  orgId       String?   @db.Uuid
  type        String    @db.Text
  title       String    @db.Text
  body        String    @db.Text
  linkUrl     String?   @db.Text
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  readAt      DateTime?
  actorUserId String?   @db.Uuid
  eventId     String?   @db.Uuid
  documentId  String?   @db.Uuid

  @@index([userId, isRead, createdAt])
  @@index([orgId, createdAt])
}

model Client {
  id                String              @id @default(uuid()) @db.Uuid
  orgId             String              @db.Uuid
  name              String              @db.Text
  slug              String              @db.Text
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  organization      Organization        @relation(fields: [orgId], references: [id])
  events            Event[]
  fnbParserFeedback FnbParserFeedback[]
  tasks             Task[]

  @@unique([orgId, slug])
  @@index([orgId])
}

model Event {
  id                            String                                 @id @default(uuid()) @db.Uuid
  orgId                         String                                 @db.Uuid
  sessionRequirementTemplateId  String?                                @db.Uuid
  clientId                      String?                                @db.Uuid
  name                          String                                 @db.Text
  startDate                     DateTime                               @db.Date
  endDate                       DateTime?                              @db.Date
  timezone                      String                                 @default("America/New_York") @db.Text
  agendaTerm                    String?                                @db.Text
  runOfShowTerm                 String?                                @db.Text
  matrixTerm                    String?                                @db.Text
  showFlowTerm                  String?                                @db.Text
  budgetApprovalsEnabled        Boolean                                @default(true)
  documentApprovalsEnabled      Boolean                                @default(true)
  venueName                     String?                                @db.Text
  city                          String?                                @db.Text
  state                         String?                                @db.Text
  status                        EventStatus
  createdByUserId               String                                 @db.Uuid
  createdAt                     DateTime                               @default(now())
  updatedAt                     DateTime                               @updatedAt
  organization                  Organization                           @relation(fields: [orgId], references: [id])
  client                        Client?                                @relation(fields: [clientId], references: [id])
  createdByUser                 User                                   @relation("EventCreatedBy", fields: [createdByUserId], references: [id])
  eventMembers                  EventMember[]
  deadlines                     Deadline[]
  budget                        Budget?
  matrixRows                    MatrixRow[]
  matrixImportBatches           MatrixImportBatch[]
  timelineImportBatches         TimelineImportBatch[]
  rooms                         Room[]
  eventActivities               EventActivity[]
  integrationMetrics            EventIntegrationMetric[]
  seatingTables                 SeatingTable[]
  seatingAttendees              SeatingAttendee[]
  seatingAssignments            SeatingAssignment[]
  seatingPlans                  SeatingPlan[]
  eventPeople                   EventPerson[]
  speakers                      Speaker[]
  speakerIntakeTokens           SpeakerIntakeToken[]
  speakerProfileSubmissions     SpeakerProfileSubmission[]
  speakerReadinessItems         SpeakerReadinessItem[]
  speakerFiles                  SpeakerFile[]
  speakerDocumentRequests       SpeakerDocumentRequest[]
  speakerMessages               SpeakerMessage[]
  speakerInternalNotes          SpeakerInternalNote[]
  speakerEmailLogs              SpeakerEmailLog[]
  speakerOnsiteInfo             SpeakerOnsiteInfo?
  documents                     Document[]
  documentCategories            DocumentCategory[]
  fnbCatalogItems               EventFnbCatalogItem[]
  fnbSourceMenus                EventFnbSourceMenu[]
  fnbParserFeedback             FnbParserFeedback[]
  fnbCatalogItemClaims          EventFnbCatalogItemClaim[]
  fnbCatalogItemSafetyRevisions EventFnbCatalogItemSafetyRevision[]
  sessionFnbRequirements        SessionFnbRequirement[]
  fnbExportRecords              EventFnbExportRecord[]
  fnbSafetyResolutions          SessionFnbAssignmentSafetyResolution[]
  timelineItems                 TimelineItem[]
  timelineDependencies          TimelineDependency[]
  copilotAuditLogs              CopilotAuditLog[]
  tasks                         Task[]
  sessionRequirementTemplate    SessionRequirementTemplate?            @relation("EventSessionRequirementTemplate", fields: [sessionRequirementTemplateId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  sessionRequirementTemplates   SessionRequirementTemplate[]           @relation("EventOwnedSessionRequirementTemplates")
  marketingPlans                MarketingPlan[]
  marketingCampaigns            MarketingCampaign[]
  marketingAudiences            MarketingAudience[]
  marketingAudienceRecipients   MarketingAudienceRecipient[]
  marketingEmailSends           MarketingEmailSend[]
  marketingEmailSendRecipients  MarketingEmailSendRecipient[]
  marketingEmailEvents          MarketingEmailEvent[]
  marketingSuppressions         MarketingSuppression[]
  marketingKpiSnapshots         MarketingKpiSnapshot[]
  directoryPeople               EventDirectoryPerson[]
  directorySources              EventDirectorySource[]
  directoryImportBatches        EventDirectoryImportBatch[]
  attendees                     EventAttendee[]
  registrationRecords           EventRegistrationRecord[]
  attendeeSessionEnrollments    EventAttendeeSessionEnrollment[]
  integrationConnections        EventIntegrationConnection[]
  attendeeExternalIdentities    EventExternalIdentity[]
  importResult                  EventImportResult?
  sessionShowFlowItems          SessionShowFlowItem[]
  sessionShowFlowStates         SessionShowFlowState[]
  sessionAgendaPublications     SessionAgendaPublication[]

  SessionSupplyAllocation SessionSupplyAllocation[]
  SessionSupplyState      SessionSupplyState[]
  SignageChecklistItem    SignageChecklistItem[]
  SignageSign             SignageSign[]
  SupplyAllocationAudit   SupplyAllocationAudit[]
  SupplyItem              SupplyItem[]
  SupplyTemplate          SupplyTemplate[]

  EventDashboardLayoutMigration EventDashboardLayoutMigration[]
  EventDashboardView            EventDashboardView?
  EventFnbSourceMenuParseJob    EventFnbSourceMenuParseJob[]
  EventFnbSourceMenuParseTarget EventFnbSourceMenuParseTarget[]
  UserDashboardLayout           UserDashboardLayout[]

  @@index([orgId])
  @@index([clientId])
  @@index([createdByUserId])
  @@index([sessionRequirementTemplateId])
}

model EventMember {
  id        String          @id @default(uuid()) @db.Uuid
  eventId   String          @db.Uuid
  userId    String          @db.Uuid
  eventRole EventMemberRole
  createdAt DateTime        @default(now())
  event     Event           @relation(fields: [eventId], references: [id])
  user      User            @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@index([userId])
}

model EventImportIntent {
  id                String                  @id @default(uuid()) @db.Uuid
  orgId             String                  @db.Uuid
  requestedByUserId String                  @db.Uuid
  idempotencyKey    String                  @db.Text
  sourceType        String                  @db.Text
  status            EventImportIntentStatus @default(PROCESSING)
  approvedAt        DateTime
  approvalEvidence  Json
  reviewedMappings  Json
  approvedPlan      Json
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  completedAt       DateTime?
  organization      Organization            @relation(fields: [orgId], references: [id])
  requestedByUser   User                    @relation("EventImportRequestedBy", fields: [requestedByUserId], references: [id])
  result            EventImportResult?

  @@unique([orgId, requestedByUserId, idempotencyKey])
  @@index([orgId, status, createdAt])
  @@index([requestedByUserId, createdAt])
}

model EventImportResult {
  id                String                  @id @default(uuid()) @db.Uuid
  intentId          String                  @unique @db.Uuid
  orgId             String                  @db.Uuid
  requestedByUserId String                  @db.Uuid
  eventId           String?                 @unique @db.Uuid
  status            EventImportResultStatus
  createdSummary    Json?
  skippedSummary    Json?
  warnings          Json?
  errorCode         String?                 @db.Text
  errorMessage      String?                 @db.Text
  httpStatus        Int?
  completedAt       DateTime                @default(now())
  intent            EventImportIntent       @relation(fields: [intentId], references: [id], onDelete: Cascade)
  organization      Organization            @relation(fields: [orgId], references: [id])
  requestedByUser   User                    @relation("EventImportResultRequestedBy", fields: [requestedByUserId], references: [id])
  event             Event?                  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([orgId, status, completedAt])
  @@index([requestedByUserId, completedAt])
}

model Task {
  id                String           @id @default(uuid()) @db.Uuid
  orgId             String           @db.Uuid
  eventId           String           @db.Uuid
  clientId          String?          @db.Uuid
  title             String           @db.Text
  description       String?          @db.Text
  status            TaskStatus       @default(OPEN)
  priority          TaskPriority     @default(MEDIUM)
  type              TaskType         @default(EVENT)
  source            TaskSource       @default(MANUAL)
  visibility        TaskVisibility   @default(INTERNAL)
  dueAt             DateTime?
  createdByUserId   String           @db.Uuid
  completedAt       DateTime?
  completedByUserId String?          @db.Uuid
  canceledAt        DateTime?
  canceledByUserId  String?          @db.Uuid
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  organization      Organization     @relation(fields: [orgId], references: [id])
  event             Event            @relation(fields: [eventId], references: [id])
  client            Client?          @relation(fields: [clientId], references: [id])
  createdByUser     User             @relation("TaskCreatedBy", fields: [createdByUserId], references: [id])
  completedByUser   User?            @relation("TaskCompletedBy", fields: [completedByUserId], references: [id])
  canceledByUser    User?            @relation("TaskCanceledBy", fields: [canceledByUserId], references: [id])
  assignments       TaskAssignment[]
  links             TaskLink[]
  comments          TaskComment[]
  activity          TaskActivity[]
  watchers          TaskWatcher[]

  @@index([orgId, eventId, status, dueAt])
  @@index([orgId, eventId, type, status])
  @@index([orgId, eventId, updatedAt])
  @@index([orgId, clientId, status, dueAt])
  @@index([createdByUserId])
  @@index([completedByUserId])
}

model TaskAssignment {
  taskId           String             @db.Uuid
  userId           String             @db.Uuid
  role             TaskAssignmentRole @default(OWNER)
  assignedByUserId String?            @db.Uuid
  createdAt        DateTime           @default(now())
  task             Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user             User               @relation("TaskAssignmentUser", fields: [userId], references: [id])
  assignedByUser   User?              @relation("TaskAssignmentAssignedBy", fields: [assignedByUserId], references: [id])

  @@id([taskId, userId])
  @@index([userId, createdAt])
  @@index([taskId, role])
}

model TaskLink {
  id            String             @id @default(uuid()) @db.Uuid
  taskId        String             @db.Uuid
  objectType    TaskLinkObjectType
  objectId      String             @db.Uuid
  labelSnapshot String?            @db.Text
  createdAt     DateTime           @default(now())
  task          Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, objectType, objectId])
  @@index([objectType, objectId])
  @@index([taskId])
}

model TaskComment {
  id           String    @id @default(uuid()) @db.Uuid
  taskId       String    @db.Uuid
  authorUserId String    @db.Uuid
  body         String    @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  task         Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorUser   User      @relation("TaskCommentAuthor", fields: [authorUserId], references: [id])

  @@index([taskId, createdAt])
  @@index([authorUserId, createdAt])
}

model TaskActivity {
  id          String           @id @default(uuid()) @db.Uuid
  taskId      String           @db.Uuid
  actorUserId String?          @db.Uuid
  type        TaskActivityType
  message     String           @db.Text
  createdAt   DateTime         @default(now())
  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorUser   User?            @relation("TaskActivityActor", fields: [actorUserId], references: [id])

  @@index([taskId, createdAt])
  @@index([actorUserId, createdAt])
}

model TaskWatcher {
  taskId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation("TaskWatcherUser", fields: [userId], references: [id])

  @@id([taskId, userId])
  @@index([userId, createdAt])
}

model Speaker {
  id                  String                     @id @default(uuid()) @db.Uuid
  eventId             String                     @db.Uuid
  name                String                     @db.Text
  email               String?                    @db.Text
  phone               String?                    @db.Text
  title               String?                    @db.Text
  company             String?                    @db.Text
  bio                 String?                    @db.Text
  headshotUrl         String?                    @db.Text
  status              SpeakerStatus              @default(NEEDS_INFO)
  notes               String?                    @db.Text
  avNeeds             String?                    @db.Text
  travelNeeds         String?                    @db.Text
  dietaryRestrictions String?                    @db.Text
  topics              String[]                   @default([])
  linkedinUrl         String?                    @db.Text
  websiteUrl          String?                    @db.Text
  intakeTokenSentAt   DateTime?
  intakeSubmittedAt   DateTime?
  reminderSentAt      DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  event               Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessionAssignments  SessionSpeakerAssignment[]
  intakeTokens        SpeakerIntakeToken[]
  profileSubmissions  SpeakerProfileSubmission[]
  readinessItems      SpeakerReadinessItem[]
  files               SpeakerFile[]
  documentRequests    SpeakerDocumentRequest[]
  messages            SpeakerMessage[]
  internalNotes       SpeakerInternalNote[]
  emailLogs           SpeakerEmailLog[]
  showFlowItems       SessionShowFlowItem[]

  @@unique([eventId, email])
  @@index([eventId, status])
  @@index([eventId])
}

model SpeakerIntakeToken {
  id          String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  speakerId   String                     @db.Uuid
  eventId     String                     @db.Uuid
  tokenHash   String                     @unique @db.Text
  expiresAt   DateTime
  submittedAt DateTime?
  revokedAt   DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  speaker     Speaker                    @relation(fields: [speakerId], references: [id], onDelete: Cascade)
  event       Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submissions SpeakerProfileSubmission[]

  @@index([speakerId, eventId])
  @@index([eventId])
  @@index([expiresAt])
}

model SpeakerProfileSubmission {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  speakerId           String                  @db.Uuid
  eventId             String                  @db.Uuid
  tokenId             String?                 @db.Uuid
  status              SpeakerSubmissionStatus @default(PENDING)
  name                String?                 @db.Text
  title               String?                 @db.Text
  company             String?                 @db.Text
  bio                 String?                 @db.Text
  phone               String?                 @db.Text
  headshotUrl         String?                 @db.Text
  avNeeds             String?                 @db.Text
  travelNeeds         String?                 @db.Text
  dietaryRestrictions String?                 @db.Text
  topics              String[]                @default([])
  linkedinUrl         String?                 @db.Text
  websiteUrl          String?                 @db.Text
  noteToPlanner       String?                 @db.Text
  submittedAt         DateTime                @default(now())
  reviewedAt          DateTime?
  reviewedByUserId    String?                 @db.Uuid
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  speaker             Speaker                 @relation(fields: [speakerId], references: [id], onDelete: Cascade)
  event               Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  token               SpeakerIntakeToken?     @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  reviewedByUser      User?                   @relation("SpeakerSubmissionReviewedBy", fields: [reviewedByUserId], references: [id])

  @@index([eventId, status])
  @@index([speakerId, status])
  @@index([tokenId])
  @@index([reviewedByUserId])
}

model SpeakerReadinessItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  speakerId   String    @db.Uuid
  eventId     String    @db.Uuid
  key         String    @db.Text
  label       String    @db.Text
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  speaker     Speaker   @relation(fields: [speakerId], references: [id], onDelete: Cascade)
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([speakerId, eventId, key])
  @@index([eventId, completed])
}

model SpeakerFile {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  speakerId         String                  @db.Uuid
  eventId           String                  @db.Uuid
  sessionId         String?                 @db.Uuid
  kind              SpeakerFileKind
  filename          String                  @db.Text
  objectKey         String                  @unique @db.Text
  contentType       String                  @db.Text
  fileSizeBytes     Int
  version           Int                     @default(1)
  reviewStatus      SpeakerFileReviewStatus @default(RECEIVED)
  reviewFeedback    String?                 @db.Text
  reviewedAt        DateTime?
  reviewedByUserId  String?                 @db.Uuid
  uploadedViaPortal Boolean                 @default(false)
  uploadedByUserId  String?                 @db.Uuid
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  speaker           Speaker                 @relation(fields: [speakerId], references: [id], onDelete: Cascade)
  event             Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session           MatrixRow?              @relation("SpeakerFileSession", fields: [sessionId], references: [id], onDelete: SetNull)
  uploadedByUser    User?                   @relation("SpeakerFileUploadedBy", fields: [uploadedByUserId], references: [id])
  reviewedByUser    User?                   @relation("SpeakerFileReviewedBy", fields: [reviewedByUserId], references: [id])

  documentRequests SpeakerDocumentRequest[]
  messages         SpeakerMessage[]
  internalNotes    SpeakerInternalNote[]

  @@index([eventId, kind])
  @@index([speakerId, kind, sessionId, version])
  @@index([speakerId])
  @@index([sessionId])
  @@index([uploadedByUserId])
  @@index([reviewedByUserId])
}

model SpeakerMessage {
  id            String               @id @default(uuid()) @db.Uuid
  eventId       String               @db.Uuid
  speakerId     String               @db.Uuid
  sessionId     String?              @db.Uuid
  speakerFileId String?              @db.Uuid
  senderType    SpeakerMessageSender
  senderUserId  String?              @db.Uuid
  body          String               @db.Text
  createdAt     DateTime             @default(now())
  event         Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speaker       Speaker              @relation(fields: [speakerId], references: [id], onDelete: Cascade)
  session       MatrixRow?           @relation("SpeakerMessageSession", fields: [sessionId], references: [id], onDelete: SetNull)
  speakerFile   SpeakerFile?         @relation(fields: [speakerFileId], references: [id], onDelete: SetNull)
  senderUser    User?                @relation("SpeakerMessageSenderUser", fields: [senderUserId], references: [id])

  @@index([eventId])
  @@index([speakerId, createdAt])
  @@index([sessionId])
  @@index([speakerFileId])

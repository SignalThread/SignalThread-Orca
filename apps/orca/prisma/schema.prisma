model EventFnbSourceMenuParseTarget {
  id           String                              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId        String                              @db.Uuid
  eventId      String                              @db.Uuid
  sourceMenuId String                              @db.Uuid
  targetKey    String
  label        String
  startPage    Int
  endPage      Int
  status       EventFnbSourceMenuParseTargetStatus @default(PENDING)
  attemptCount Int                                 @default(0)
  errorMessage String?
  itemsJson    Json?
  ledgerJson   Json?
  usageJson    Json?
  startedAt    DateTime?
  completedAt  DateTime?
  failedAt     DateTime?
  createdAt    DateTime                            @default(now())
  updatedAt    DateTime                            @default(now())

  Event                      Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  EventFnbSourceMenuParseJob EventFnbSourceMenuParseJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  EventFnbSourceMenu         EventFnbSourceMenu         @relation(fields: [sourceMenuId], references: [id], onDelete: Cascade)

  @@unique([jobId, targetKey])
  @@index([eventId, sourceMenuId])
  @@index([jobId, status, startPage])
}


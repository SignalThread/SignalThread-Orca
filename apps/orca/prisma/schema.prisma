// ============================================================================
// Event Directory — canonical event-level people/contact layer.
// A person exists once per event and can hold many roles. New, additive models;
// existing Speaker / SeatingAttendee / EventPerson flows are untouched and are
// bridged via EventDirectoryModuleLink (see Prompt 6 backfill).
// ============================================================================

model EventDirectoryPerson {
  id                       String                           @id @default(uuid()) @db.Uuid
  orgId                    String                           @db.Uuid
  clientId                 String?                          @db.Uuid
  eventId                  String                           @db.Uuid
  firstName                String?                          @db.Text
  lastName                 String?                          @db.Text
  displayName              String                           @db.Text
  email                    String?                          @db.Text
  normalizedEmail          String?                          @db.Text
  phone                    String?                          @db.Text
  company                  String?                          @db.Text
  title                    String?                          @db.Text
  status                   EventDirectoryPersonStatus       @default(ACTIVE)
  createdByUserId          String?                          @db.Uuid
  updatedByUserId          String?                          @db.Uuid
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt
  deletedAt                DateTime?
  event                    Event                            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roles                    EventDirectoryRole[]
  externalIdentities       EventDirectoryExternalIdentity[]
  moduleLinks              EventDirectoryModuleLink[]
  matchedImportRows        EventDirectoryImportRow[]        @relation("DirectoryImportRowMatchedPerson")
  attendee                 EventAttendee?
  registrationRecords      EventRegistrationRecord[]
  externalObjectIdentities EventExternalIdentity[]

  @@index([eventId, normalizedEmail])
  @@index([eventId, status])
  @@index([eventId, company])
  @@index([eventId, displayName])
  @@index([orgId])
  @@index([clientId])
}

model EventDirectoryRole {
  id              String                 @id @default(uuid()) @db.Uuid
  eventId         String                 @db.Uuid
  personId        String                 @db.Uuid
  role            EventDirectoryRoleType
  sourceId        String?                @db.Uuid
  createdByUserId String?                @db.Uuid
  createdAt       DateTime               @default(now())
  person          EventDirectoryPerson   @relation(fields: [personId], references: [id], onDelete: Cascade)
  source          EventDirectorySource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([eventId, personId, role])
  @@index([eventId, role])
  @@index([personId])
  @@index([sourceId])
}

model EventDirectorySource {
  id              String                      @id @default(uuid()) @db.Uuid
  eventId         String                      @db.Uuid
  type            EventDirectorySourceType
  label           String                      @db.Text
  provider        String?                     @db.Text
  createdByUserId String?                     @db.Uuid
  createdAt       DateTime                    @default(now())
  event           Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roles           EventDirectoryRole[]
  importBatches   EventDirectoryImportBatch[]

  @@unique([eventId, type, label])
  @@index([eventId, type])
  @@index([eventId, label])
}

model EventDirectoryExternalIdentity {
  id                     String                   @id @default(uuid()) @db.Uuid
  eventId                String                   @db.Uuid
  personId               String                   @db.Uuid
  provider               String                   @db.Text
  externalPersonId       String                   @db.Text
  externalRegistrationId String?                  @db.Text
  externalAccountId      String?                  @db.Text
  externalEventId        String?                  @db.Text
  syncStatus             EventDirectorySyncStatus @default(LINKED)
  lastPulledAt           DateTime?
  lastPushedAt           DateTime?
  externalUpdatedAt      DateTime?
  syncError              String?                  @db.Text
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  person                 EventDirectoryPerson     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([eventId, provider, externalPersonId])
  @@index([personId])
  @@index([eventId, provider])
}

model EventDirectoryImportBatch {
  id               String                     @id @default(uuid()) @db.Uuid
  eventId          String                     @db.Uuid
  sourceId         String?                    @db.Uuid
  fileName         String?                    @db.Text
  uploadedByUserId String?                    @db.Uuid
  uploadedAt       DateTime                   @default(now())
  targetRole       EventDirectoryRoleType?
  sourceLabel      String?                    @db.Text
  totalRows        Int                        @default(0)
  createdCount     Int                        @default(0)
  updatedCount     Int                        @default(0)
  duplicateCount   Int                        @default(0)
  invalidCount     Int                        @default(0)
  skippedCount     Int                        @default(0)
  status           EventDirectoryImportStatus @default(PENDING)
  event            Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  source           EventDirectorySource?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)

model EventFnbSourceMenuParseJob {
  id                   String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId              String                           @db.Uuid
  sourceMenuId         String                           @unique @db.Uuid
  status               EventFnbSourceMenuParseJobStatus @default(QUEUED)
  workerMode           String                           @default("bounded_menu_map_worker")

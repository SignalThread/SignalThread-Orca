// ============================================================================
// Registration integration foundation — provider-AGNOSTIC. No real provider is
// implemented; capability flags drive UI/service behavior so future Aura/
// Bizzabo/etc. adapters plug in without changing the attendee core.
// ============================================================================

model EventIntegrationConnection {
  id                          String                           @id @default(uuid()) @db.Uuid
  eventId                     String                           @db.Uuid
  provider                    String                           @db.Text
  externalEventId             String?                          @db.Text
  connectionStatus            EventIntegrationConnectionStatus @default(NOT_CONNECTED)
  syncMode                    EventIntegrationSyncMode         @default(READ_ONLY)
  lastSyncAt                  DateTime?
  canPullAttendees            Boolean                          @default(false)
  canCreateAttendees          Boolean                          @default(false)
  canUpdateAttendees          Boolean                          @default(false)
  canCancelAttendees          Boolean                          @default(false)
  canPullSessions             Boolean                          @default(false)
  canPushSessions             Boolean                          @default(false)
  canPullSessionRegistrations Boolean                          @default(false)
  canPushSessionRegistrations Boolean                          @default(false)
  supportsWebhooks            Boolean                          @default(false)
  supportsOrders              Boolean                          @default(false)
  supportsBadgeTypes          Boolean                          @default(false)
  createdByUserId             String?                          @db.Uuid
  createdAt                   DateTime                         @default(now())
  updatedAt                   DateTime                         @updatedAt
  event                       Event                            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessionEnrollments          EventAttendeeSessionEnrollment[]

  @@unique([eventId, provider])
  @@index([eventId])
}

model EventExternalIdentity {
  id                 String               @id @default(uuid()) @db.Uuid

  event       Event               @relation(fields: [eventId], references: [id])
  matrixRow   MatrixRow?          @relation(fields: [matrixRowId], references: [id], onDelete: Cascade)
  tables      SeatingTable[]
  assignments SeatingAssignment[]

  @@unique([matrixRowId])
  @@index([eventId])
  @@index([eventId, matrixRowId])
}

model SeatingTable {
  id            String              @id @default(uuid()) @db.Uuid
  eventId       String              @db.Uuid
  seatingPlanId String?             @db.Uuid
  name          String              @db.Text
  capacity      Int
  sortOrder     Int
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  event         Event               @relation(fields: [eventId], references: [id])
  seatingPlan   SeatingPlan?        @relation(fields: [seatingPlanId], references: [id], onDelete: Cascade)
  assignments   SeatingAssignment[]

  @@index([eventId, sortOrder])
  @@index([eventId, seatingPlanId, sortOrder])
  @@index([seatingPlanId])
}

model SeatingAttendee {
  id              String              @id @default(uuid()) @db.Uuid
  eventId         String              @db.Uuid
  eventAttendeeId String?             @unique @db.Uuid
  firstName       String              @db.Text
  lastName        String              @db.Text
  company         String?             @db.Text
  email           String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  event           Event               @relation(fields: [eventId], references: [id])
  eventAttendee   EventAttendee?      @relation(fields: [eventAttendeeId], references: [id], onDelete: SetNull)
  assignments     SeatingAssignment[]

  @@index([eventId, lastName, firstName])
  @@index([eventId, email])
  @@index([eventId, eventAttendeeId])
}

model SeatingAssignment {
  id            String          @id @default(uuid()) @db.Uuid
  eventId       String          @db.Uuid
  tableId       String          @db.Uuid
  attendeeId    String          @db.Uuid
  seatingPlanId String?         @db.Uuid
  seatIndex     Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  event         Event           @relation(fields: [eventId], references: [id])
  table         SeatingTable    @relation(fields: [tableId], references: [id])
  attendee      SeatingAttendee @relation(fields: [attendeeId], references: [id])
  seatingPlan   SeatingPlan?    @relation(fields: [seatingPlanId], references: [id], onDelete: Cascade)

  @@unique([tableId, attendeeId])
  @@unique([tableId, seatIndex])
  @@unique([eventId, attendeeId], map: "SeatingAssignment_event_attendee_event_level_key", where: raw("(\"seatingPlanId\" IS NULL)"))
  @@unique([eventId, attendeeId, seatingPlanId], map: "SeatingAssignment_event_attendee_plan_key", where: raw("(\"seatingPlanId\" IS NOT NULL)"))
  @@index([eventId])
  @@index([eventId, tableId])
  @@index([eventId, seatingPlanId])
  @@index([tableId])
  @@index([seatingPlanId])
}

// Controlled baseline parity: these map audited live dashboard tables; no runtime uses them yet.
model UserDashboardLayout {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  eventId   String   @db.Uuid
  roleKey   String
  layout    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  Event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  User  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId, roleKey])
  @@index([eventId, roleKey])
  @@index([userId])
}

enum EventDashboardViewStarterKey {
  EXECUTIVE
  EVENT_LEAD
  FUNCTIONAL
  CUSTOM
  MIGRATED
}

enum EventDashboardViewVisibility {
  PRIVATE
  TEAM
}

model EventDashboardView {
  id             String                       @id @db.Uuid
  organizationId String                       @db.Uuid
  eventId        String                       @unique(map: "EventDashboardView_one_active_team_default_per_event", where: raw("((\"isTeamDefault\" = true) AND (\"archivedAt\" IS NULL))")) @db.Uuid
  ownerUserId    String                       @db.Uuid
  name           String
  description    String?
  starterKey     EventDashboardViewStarterKey
  visibility     EventDashboardViewVisibility @default(PRIVATE)
  isTeamDefault  Boolean                      @default(false)
  archivedAt     DateTime?
  layoutVersion  Int                          @default(1)
  configuration  Json
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime

  Event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  Organization Organization @relation(fields: [organizationId], references: [id])
  User         User         @relation(fields: [ownerUserId], references: [id])

  EventDashboardViewPreference EventDashboardViewPreference[]

  @@index([eventId, archivedAt])
  @@index([eventId, visibility])
  @@index([organizationId])
  @@index([ownerUserId, eventId])
}

model EventDashboardViewPreference {
  id                String    @id @db.Uuid
  viewId            String    @db.Uuid
  userId            String    @db.Uuid
  isPersonalDefault Boolean   @default(false)
  lastUsedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime

  User               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  EventDashboardView EventDashboardView @relation(fields: [viewId], references: [id], onDelete: Cascade)

  @@unique([viewId, userId])
  @@index([userId, isPersonalDefault])
}

model EventDashboardLayoutMigration {
  id          String   @id @db.Uuid
  eventId     String   @db.Uuid
  userId      String   @db.Uuid
  sourceKey   String
  viewId      String?  @db.Uuid
  outcome     String
  completedAt DateTime @default(now())

  Event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  User  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}


  event              Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person             EventDirectoryPerson @relation(fields: [directoryPersonId], references: [id], onDelete: Cascade)
  attendee           EventAttendee?       @relation(fields: [attendeeId], references: [id], onDelete: SetNull)

  @@unique([eventId, provider, externalObjectType, externalObjectId])
  @@index([directoryPersonId])
  @@index([attendeeId])
  @@index([eventId, provider])
}

enum EventIntegrationConnectionStatus {

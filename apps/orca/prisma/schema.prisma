  completedTargetCount Int                              @default(0)
  failedTargetCount    Int                              @default(0)
  mapCreatedAt         DateTime?

  Event              Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  EventFnbSourceMenu EventFnbSourceMenu @relation(fields: [sourceMenuId], references: [id], onDelete: Cascade)


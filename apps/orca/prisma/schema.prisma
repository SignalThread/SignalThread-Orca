  rowNumber       Int
  rawName         String?                       @db.Text
  rawEmail        String?                       @db.Text
  rawCompany      String?                       @db.Text
  parsedFirstName String?                       @db.Text
  parsedLastName  String?                       @db.Text
  parsedEmail     String?                       @db.Text
  result          EventDirectoryImportRowResult
  matchedPersonId String?                       @db.Uuid
  errorMessage    String?                       @db.Text
  createdAt       DateTime                      @default(now())

# ============================================================
# DEVELOPMENT ENVIRONMENT (.env.local)
# ============================================================
# Local development configuration with MinIO and local/dev database
# Copy this file to .env.local and update as needed
#
# ============================================================

# ============================================================
# DATABASE (Development)
# ============================================================
# Option 1: Local PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booth_audio?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/booth_audio?schema=public"

# Option 2: Supabase (recommended)
# 1. Create project at https://supabase.com
# 2. Get connection pooler string: Project Settings → Database → Connection Pooling
# 3. Use Session pooler (port 5432) for both runtime and migrations
# 4. DO NOT use pgbouncer=true parameter (causes circuit breaker issues)
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# ============================================================
# OBJECT STORAGE (MinIO - Local S3 Compatible)
# ============================================================
# Start MinIO: docker run -p 9000:9000 -p 9001:9001 minio/minio server /data --console-address ":9001"
# MinIO Console: http://localhost:9001 (minioadmin / minioadmin)
S3_BUCKET_NAME="booth-audio-dev"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_ENDPOINT="http://localhost:9000"
# Exact origin embedded in browser presigned URLs. Set this separately when
# the Next.js server reaches storage through an internal/container hostname.
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_FORCE_PATH_STYLE=true

# Presigned URL expiration (5 minutes)
S3_UPLOAD_EXPIRES_IN=300

# ============================================================
# FILE UPLOAD CONSTRAINTS
# ============================================================
MAX_FILE_SIZE_BYTES=52428800  # 50MB
ALLOWED_MIME_TYPES="audio/webm,audio/mp4,audio/mpeg,audio/wav,audio/ogg"

# ============================================================
# AI SERVICES (OpenAI)
# ============================================================
# [REQUIRED] Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Service configuration
TRANSCRIPTION_PROVIDER="openai"
TRANSCRIPTION_MODEL="whisper-1"
ANALYSIS_PROVIDER="openai"
ANALYSIS_MODEL="gpt-4-turbo-preview"
ANALYSIS_PROMPT_VERSION="v1.0"

# ============================================================
# APP CONFIGURATION
# ============================================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Canonical Event action assignment email provider. When omitted, assignments
# still persist and the delivery is recorded as failed for explicit retry.
RESEND_API_KEY=""
EVENT_ACTION_EMAIL_FROM="SignalThread <actions@example.com>"

# Public marketing site origin (Stripe success → /signup/success, cancel → /#pricing). Not the Voice app.
# Local: Vite marketing site. Production: https://www.signalthread.ai (or set explicitly)
MARKETING_SITE_URL="http://localhost:5173"


# Template demo mode (auto-enabled in development)
# NEXT_PUBLIC_ENABLE_TEMPLATE_DEMO="true"

# ============================================================
# PROCESSING CONFIGURATION
# ============================================================
MAX_PROCESSING_RETRIES=3
PROCESSING_TIMEOUT_MS=300000

{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ]
    },
    "target": "ES2015",
    "downlevelIteration": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-playwright-mocked/types/**/*.ts",
    ".next-playwright-real/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "docs-site",
    "docs-site/**",
    "docs-site/.astro",
    "docs-site/.astro/**",
    "docs-site/dist",
    "docs-site/dist/**",
    "docs-site/node_modules",
    "docs-site/node_modules/**"
  ]
}

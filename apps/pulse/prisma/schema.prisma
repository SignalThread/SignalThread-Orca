enum ResponseStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model Answer {
  id         String  @id @default(cuid())
  responseId String
  questionId String?

  // Question reference (from Event.questionsJson)
  questionKey String // Stable key like "q1_food_quality"
  promptLabel String // Display label for the question

  // Audio file metadata
  objectKey     String? @unique
  objectEtag    String?
  mimeType      String?
  fileSizeBytes Int?
  durationMs    Int?

  // Canonical value for fixed-range structured questions. Voice and typed
  // free-text answers continue to use their existing audio/transcript paths.
  numericValue Int?
  /// Stable EventSpeakerProfile identity for a per-presenter answer. This is
  /// deliberately an ID, not a copied display name; the current speaker
  /// profile remains the canonical source for presentation and analytics.
  speakerId    String?

  // Processing status
  status       AnswerStatus @default(CREATED)
  statusReason String?      @db.Text

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  response                Response                 @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question                Question?                @relation(fields: [questionId], references: [id], onDelete: SetNull)
  answerTranscript        AnswerTranscript?
  answerAnalysis          AnswerAnalysis?
  answerEventIntelligence AnswerEventIntelligence?
  answerEventThemes       AnswerEventTheme[]
  answerEventEntities     AnswerEventEntity[]
  answerEventActions      AnswerEventAction[]
  eventIssueEvidence      EventIssueEvidence[]
  answerLogs              AnswerProcessingLog[]
  insightSourceAnswers    InsightSourceAnswer[]

  @@index([responseId])
  @@index([questionId])
  @@index([questionId, numericValue])
  @@index([speakerId])
  @@index([questionId, speakerId])
  @@index([questionKey])
  @@index([status])
  @@index([createdAt])
}

enum AnswerStatus {
  CREATED
  UPLOADING
  UPLOADED
  PROCESSING_TRANSCRIPT
  PROCESSING_ANALYSIS
  COMPLETED
  FAILED
}


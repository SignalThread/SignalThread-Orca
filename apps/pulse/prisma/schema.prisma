generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// MULTI-TENANT HIERARCHY: Account → Location → Event
// ============================================================

model Account {
  id   String @id @default(cuid())
  name String
  slug String @unique // URL-safe identifier

  /// Canonical SignalThread Platform Core organization id. Additive, nullable and
  /// explicitly assigned. Deliberately NOT unique: one Account maps to at most one
  /// organization, but an organization may own several Pulse Accounts (production has a
  /// single contact email across 12 RETAIL accounts, and RETAIL/EVENTS are separate
  /// account types). Resolution treats more than one match as ambiguous rather than
  /// picking a row. See docs/PLATFORM_IDENTITY_MAPPING.md.
  platformOrganizationId String? @db.Uuid

  // Account type and tier
  accountType AccountType @default(RETAIL)
  tier        String      @default("starter") // starter, growth, enterprise (plan)

  // Trial (Starter: 30-day free trial from creation)
  trialEndsAt DateTime?

  // Account status
  isActive Boolean @default(true)

  // Contact and billing
  email                String?
  phone                String?
  stripeCustomerId     String? @unique // Stripe customer ID for webhook lookups
  stripeSubscriptionId String? // Stripe subscription ID
  billingJson          Json? // Flexible billing metadata (status, plan, etc.)

  // Settings and customization
  settingsJson Json? // Account-level preferences

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  locations                   Location[]
  users                       User[] // Supabase authenticated users
  userMemberships             AccountUserMembership[]
  admins                      Admin[] // Legacy admins (deprecated)
  pendingProvisions           PendingProvision[] // Onboarding provisions
  answerEventIntelligence     AnswerEventIntelligence[]
  eventIntelligenceAggregates EventIntelligenceAggregate[]
  eventIssueClusters          EventIssueCluster[]
  eventIssueEvidence          EventIssueEvidence[]
  eventAlertNotes             EventAlertNote[]
  eventActionHistory          EventActionHistory[]
  eventActionUpdates          EventActionUpdate[]
  eventActionDeliveries       EventActionAssignmentDelivery[]
  eventActionDeliveryAttempts EventActionDeliveryAttempt[]
  eventSpeakerProfiles        EventSpeakerProfile[]
  eventAgendaImportJobs       EventAgendaImportJob[]
  eventClosingBriefSnapshots  EventClosingBriefSnapshot[]
  platformUserActionAudits    PlatformUserActionAudit[]

  @@index([slug])
  @@index([accountType])
  @@index([isActive])
  @@index([platformOrganizationId])
}

enum AccountType {
  RETAIL // Coffee shops, restaurants, retail stores
  EVENTS // Conferences, festivals, corporate events
  HOSPITALITY // Hotels, venues, resorts
}

model Location {
  id        String @id @default(cuid())
  accountId String
  name      String
  slug      String // URL-safe, unique within account

  // Location details
  address    String?
  city       String?
  state      String?
  postalCode String?
  country    String  @default("US")
  timezone   String  @default("America/New_York")

  // Location settings
  isActive        Boolean @default(true)
  settingsJson    Json? // Location-specific preferences
  googleReviewUrl String? // Google review link for retail locations

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  account                     Account                      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  events                      Event[]
  sessions                    Session[] // Backward compatible: sessions can link to location
  surveyTargets               SurveyTarget[]
  structureItems              EventStructureItem[]
  answerEventIntelligence     AnswerEventIntelligence[]
  eventIntelligenceAggregates EventIntelligenceAggregate[]
  eventIssueClusters          EventIssueCluster[]
  eventIssueEvidence          EventIssueEvidence[]

  @@unique([accountId, slug])
  @@index([accountId])
  @@index([slug])
  @@index([isActive])
}

enum ResponseMode {
  VOICE_ONLY
  TEXT_ONLY
  VOICE_AND_TEXT
}

enum SurveyPresentationMode {
  SCREEN
  READ_ALOUD
  ATTENDEE_CHOOSES
}

enum QuestionType {
  /// Legacy open-response value retained for existing non-Advanced flows.
  VOICE
  OPEN_RESPONSE
  RATING_1_TO_5
  RECOMMENDATION_0_TO_10
  YES_NO
  SINGLE_CHOICE
  SPEAKER_FEEDBACK
}

/// Describes the canonical subject of a survey question. SPEAKERS is only
/// valid for a rating question in a session-targeted survey; it expands to
/// one Answer per speaker at response time.
enum QuestionResponseTarget {
  GENERAL
  SESSION
  SPEAKERS
}

model Event {
  id          String  @id @default(cuid())
  locationId  String
  name        String
  description String? @db.Text

  /// Canonical SignalThread Platform Core event id. Pulse Event is overloaded: it backs
  /// both Events-product workspaces and Retail feedback campaigns, so this stays nullable
  /// and is assigned explicitly — a Retail campaign never receives one and nothing infers
  /// a mapping from name, slug or demo data. Unique so a canonical event resolves to one
  /// Pulse workspace; Postgres allows unlimited NULLs, so unmapped rows are unaffected.
  platformEventId String? @unique @db.Uuid

  // Kiosk / survey: how respondents may answer (voice, text, or both)
  responseMode ResponseMode @default(VOICE_ONLY)

  // Event type and configuration
  eventType EventType @default(FEEDBACK)

  // Event scheduling
  startDate               DateTime?
  endDate                 DateTime?
  /// Optional Events-only override. When empty, the canonical default is
  /// computed as five days before/after the event's own boundaries.
  listeningWindowOpensAt  DateTime?
  listeningWindowClosesAt DateTime?

  // Optional free-text venue (e.g. "Hilton Riverwalk, San Antonio").
  // The Location relation is the account-level Event Workspace; venue is the
  // physical place the event is held.
  venue String?

  // Starting-point template used at creation (conference | expo | workshop |
  // brand-activation | blank | null for legacy events). Records provenance of
  // any starter Event structure that was seeded; structure remains editable.
  templateKey String?

  // Event status
  status   EventStatus @default(DRAFT)
  isActive Boolean     @default(true)

  // Questions configuration
  questionsJson Json? // Array of question objects

  // Event-level TTS settings
  ttsProvider String @default("google")
  ttsVoice    String @default("en-US-Neural2-F")
  ttsLocale   String @default("en-US")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  location                    Location                        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  questions                   Question[]
  responses                   Response[]
  insights                    Insight[]
  surveyTargets               SurveyTarget[]
  structureItems              EventStructureItem[]
  surveys                     Survey[]
  answerEventIntelligence     AnswerEventIntelligence[]
  answerEventThemes           AnswerEventTheme[]
  answerEventEntities         AnswerEventEntity[]
  answerEventActions          AnswerEventAction[]
  eventIntelligenceAggregates EventIntelligenceAggregate[]
  eventIssueClusters          EventIssueCluster[]
  eventIssueEvidence          EventIssueEvidence[]
  eventAlertNotes             EventAlertNote[]
  eventActionHistory          EventActionHistory[]
  eventActionUpdates          EventActionUpdate[]
  eventActionDeliveries       EventActionAssignmentDelivery[]
  eventActionDeliveryAttempts EventActionDeliveryAttempt[]
  speakerAssignments          EventSessionSpeakerAssignment[] @relation("EventSpeakerAssignmentEvent")
  agendaImportJobs            EventAgendaImportJob[]
  closingBriefSnapshots       EventClosingBriefSnapshot[]

  @@index([locationId])
  @@index([status])
  @@index([eventType])
  @@index([isActive])
  @@index([startDate])
}

/// Persisted canonical Event Intelligence Brief. The sourceHash is derived
/// from the Event-owned intelligence/data revisions so unchanged page loads
/// and PDF exports reuse exactly the same generated payload.
model EventClosingBriefSnapshot {
  id          String   @id @default(cuid())
  accountId   String
  eventId     String
  lifecyclePhase String
  sourceHash  String
  briefHash   String
  briefJson   Json
  generatedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([accountId, eventId])
  @@index([briefHash])
  @@unique([eventId, lifecyclePhase])
}

model Question {
  id       String  @id @default(cuid())
  eventId  String
  surveyId String?

  // Stable identifier preserved from Event.questionsJson
  key String

  // Displayed question text and optional spoken override
  label    String       @db.Text
  ttsText  String?      @db.Text
  type     QuestionType @default(VOICE)
  responseTarget QuestionResponseTarget @default(GENERAL)
  /// Type-specific content configuration. Currently used for canonical
  /// single-choice option labels; delivery/voice settings never live here.
  configurationJson Json?
  order    Int
  required Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event                       Event                        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  survey                      Survey?                      @relation(fields: [surveyId], references: [id], onDelete: SetNull)
  audioAssets                 QuestionAudioAsset[]
  answers                     Answer[]
  answerEventIntelligence     AnswerEventIntelligence[]
  eventIntelligenceAggregates EventIntelligenceAggregate[]
  eventIssueClusters          EventIssueCluster[]
  eventIssueEvidence          EventIssueEvidence[]

  @@unique([eventId, key])
  @@unique([surveyId, order])
  @@index([eventId, order])
  @@index([surveyId])
  @@index([type])
}

model QuestionAudioAsset {
  id         String @id @default(cuid())
  questionId String

  // TTS generation identity
  provider   String
  voice      String
  language   String @default("")
  locale     String @default("")
  textHash   String
  sourceText String @db.Text

  // Stored audio metadata
  objectKey  String  @unique
  storageUrl String?
  mimeType   String  @default("audio/mpeg")
  durationMs Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, provider, voice, language, locale, textHash])
  @@index([questionId, createdAt])
  @@index([questionId, provider, voice, language, locale])
}

enum EventType {
  // Customer-facing Events-account creation modes. Legacy values below remain
  // valid for historical events and non-Events product surfaces.
  TEMPLATE
  BLANK
  ADVANCED
  FEEDBACK // General feedback collection
  SURVEY // Structured surveys
  INTERVIEW // One-on-one interviews
  KIOSK // Unattended kiosk mode
}

enum EventStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum SurveyAvailabilityMode {
  OPEN_IMMEDIATELY
  CUSTOM_WINDOW
  RELATIVE_TO_EVENT_AREA
}

enum SurveyAvailabilityAnchor {
  START
  END
}

enum SurveyAvailabilityOverride {
  FORCE_OPEN
  FORCE_CLOSED
}

/// Immutable collection cohort for Event survey evidence. Historical rows are
/// nullable until they are explicitly classified by a separate data audit.
enum CollectionPhase {
  PRE
  DURING
  POST
}

enum SurveyTargetCategory {
  EVENT
  SESSION
  LOCATION
  CUSTOM
  SPEAKER
}

enum EventStructureItemKind {
  EVENT
  SESSION
  AREA
  SPONSOR_ACTIVATION
  CUSTOM_TOUCHPOINT
}

enum EventSpeakerHeadshotState {
  NONE
  PENDING
  READY
  FAILED
}

enum EventSpeakerRole {
  SPEAKER
  MODERATOR
  HOST
  PANELIST
}

enum EventAgendaImportStatus {
  UPLOADED
  MAPPING
  NEEDS_REVIEW
  READY
  CONFIRMING
  COMPLETED
  FAILED
  CANCELLED
}

enum EventAgendaImportRowStatus {
  PENDING
  READY
  NEEDS_REVIEW
  DUPLICATE
  INVALID
  IGNORED
  CONFIRMED
  FAILED
}

enum EventAgendaImportConflictType {
  EXACT_DUPLICATE
  EXTERNAL_ID_MATCH
  POSSIBLE_DUPLICATE
  POSSIBLE_OVERLAP
  AMBIGUOUS_SPEAKER_MATCH
}

enum EventAgendaImportResolution {
  SKIP
  REPLACE_EXISTING
  KEEP_BOTH
  REVIEW
}

enum EventAgendaImportRowResult {
  CREATED
  UPDATED
  SKIPPED
  FAILED
}

model EventStructureItem {
  id          String                 @id @default(cuid())
  eventId     String
  kind        EventStructureItemKind
  name        String
  slug        String
  description String?                @db.Text
  parentId    String?
  locationId  String?
  startsAt    DateTime?
  endsAt      DateTime?
  timezone    String?
  sortOrder   Int                    @default(0)
  metadata    Json?
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  event              Event                           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  parent             EventStructureItem?             @relation("EventStructureItemChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children           EventStructureItem[]            @relation("EventStructureItemChildren")
  location           Location?                       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  surveyTargets      SurveyTarget[]
  speakerAssignments EventSessionSpeakerAssignment[] @relation("EventSessionSpeakerAssignmentSession")
  matchedImportRows  EventAgendaImportRow[]          @relation("EventAgendaImportExistingSession")
  importedByRows     EventAgendaImportRow[]          @relation("EventAgendaImportResultSession")

  @@unique([eventId, slug])
  @@unique([eventId, id])
  @@index([eventId])
  @@index([kind])
  @@index([parentId])
  @@index([locationId])
}

/// Account-scoped speaker identity. Event participation belongs to the
/// EventSessionSpeakerAssignment join; imported speaker text is never the
/// canonical profile.
model EventSpeakerProfile {
  id                String                    @id @default(cuid())
  accountId         String
  name              String
  title             String?
  organization      String?
  email             String?
  phone             String?
  biography         String?                   @db.Text
  headshotState     EventSpeakerHeadshotState @default(NONE)
  headshotObjectKey String?
  headshotMimeType  String?
  /// Derived matching key; never displayed as speaker-entered data.
  normalizedName    String
  /// Derived matching key; null when no email is present.
  normalizedEmail   String?
  isArchived        Boolean                   @default(false)
  archivedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  account            Account                         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sessionAssignments EventSessionSpeakerAssignment[]
  surveyTargets      SurveyTarget[]                  @relation("SurveyTargetSpeaker")

  @@unique([accountId, id])
  @@index([accountId, normalizedName])
  @@index([accountId, normalizedEmail])
  @@index([accountId, isArchived])
}

/// Canonical event participation for an account-scoped speaker. A null
/// sessionId is the independent roster membership used by Blank/Advanced
/// experiences; non-null sessionId rows are session assignments. Template
/// events derive speaker participation exclusively from non-null assignments.
/// The composite relations prevent an assignment from pointing at a speaker
/// in another account or a session in another event.
model EventSessionSpeakerAssignment {
  id        String           @id @default(cuid())
  accountId String
  eventId   String
  sessionId String?
  speakerId String
  role      EventSpeakerRole @default(SPEAKER)
  sortOrder Int              @default(0)
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  event                  Event               @relation("EventSpeakerAssignmentEvent", fields: [eventId], references: [id], onDelete: Cascade)
  session                EventStructureItem? @relation("EventSessionSpeakerAssignmentSession", fields: [eventId, sessionId], references: [eventId, id], onDelete: Cascade)
  speaker                EventSpeakerProfile @relation(fields: [accountId, speakerId], references: [accountId, id], onDelete: Cascade)
  speakerSurveyTargets   SurveyTarget[]      @relation("SurveyTargetSpeakerAssignment")
  speakerSurveyLinks     PublicSurveyLink[]  @relation("PublicSurveyLinkSpeakerAssignment")
  speakerSurveyResponses Response[]          @relation("ResponseSpeakerAssignment")

  @@unique([sessionId, speakerId])
  @@index([eventId, sessionId, sortOrder])
  @@index([accountId, speakerId])
}

/// Durable, server-owned agenda import state. Confirmation uses an atomic
/// all-or-nothing transaction; a failed confirmation leaves the job and rows
/// available for correction/retry without partial agenda writes.
model EventAgendaImportJob {
  id                   String                  @id @default(cuid())
  accountId            String
  eventId              String
  createdByUserId      String?
  confirmedByUserId    String?
  status               EventAgendaImportStatus @default(UPLOADED)
  idempotencyKey       String
  sourceFileName       String
  sourceMimeType       String
  sourceFileSizeBytes  Int
  sourceChecksumSha256 String
  sourceObjectKey      String?                 @unique
  worksheetName        String?
  worksheetIndex       Int?
  mappingSnapshot      Json?
  failureCode          String?
  failureMessage       String?                 @db.Text
  createdSessionCount  Int                     @default(0)
  updatedSessionCount  Int                     @default(0)
  skippedRowCount      Int                     @default(0)
  duplicateRowCount    Int                     @default(0)
  failedRowCount       Int                     @default(0)
  createdSpeakerCount  Int                     @default(0)
  matchedSpeakerCount  Int                     @default(0)
  confirmedAt          DateTime?
  completedAt          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  account         Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  event           Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdByUser   User?                  @relation("EventAgendaImportCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  confirmedByUser User?                  @relation("EventAgendaImportConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  rows            EventAgendaImportRow[]

  @@unique([eventId, id])
  @@unique([eventId, idempotencyKey])
  @@index([accountId, createdAt])
  @@index([eventId, status])
  @@index([eventId, sourceChecksumSha256])
  @@index([createdByUserId])
  @@index([confirmedByUserId])
}

/// Durable source-row review and result record. Raw and normalized snapshots
/// preserve traceability; speakerResolutionSnapshot stores review decisions,
/// not canonical speaker profiles.
model EventAgendaImportRow {
  id                        String                         @id @default(cuid())
  eventId                   String
  importJobId               String
  sourceRowNumber           Int
  stableSourceKey           String
  sourceExternalId          String?
  rawRowSnapshot            Json
  normalizedRowSnapshot     Json?
  validationIssues          Json?
  status                    EventAgendaImportRowStatus     @default(PENDING)
  conflictType              EventAgendaImportConflictType?
  resolution                EventAgendaImportResolution?
  speakerResolutionSnapshot Json?
  existingSessionId         String?
  result                    EventAgendaImportRowResult?
  resultSessionId           String?
  resultMessage             String?                        @db.Text
  processedAt               DateTime?
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt

  importJob       EventAgendaImportJob @relation(fields: [eventId, importJobId], references: [eventId, id], onDelete: Cascade)
  existingSession EventStructureItem?  @relation("EventAgendaImportExistingSession", fields: [existingSessionId], references: [id], onDelete: SetNull)
  resultSession   EventStructureItem?  @relation("EventAgendaImportResultSession", fields: [resultSessionId], references: [id], onDelete: SetNull)

  @@unique([importJobId, sourceRowNumber])
  @@unique([importJobId, stableSourceKey])
  @@index([eventId, status])
  @@index([eventId, sourceExternalId])
  @@index([eventId, existingSessionId])
  @@index([eventId, resultSessionId])
}

model SurveyTarget {
  id                   String               @id @default(cuid())
  eventId              String
  locationId           String?
  eventStructureItemId String?
  /// Optional explicit speaker-in-session scope. Generic session targets leave
  /// this null and must never be attributed to a speaker.
  speakerAssignmentId  String?
  /// Direct account-speaker identity for event-scoped speaker surveys. This
  /// remains distinct from speakerAssignmentId, which is optional session
  /// launch context for a response/link.
  speakerId            String?
  category             SurveyTargetCategory
  name                 String
  slug                 String
  description          String?              @db.Text
  metadata             Json?
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  event                       Event                          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  location                    Location?                      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  eventStructureItem          EventStructureItem?            @relation(fields: [eventStructureItemId], references: [id], onDelete: SetNull)
  speakerAssignment           EventSessionSpeakerAssignment? @relation("SurveyTargetSpeakerAssignment", fields: [speakerAssignmentId], references: [id], onDelete: SetNull)
  speaker                     EventSpeakerProfile?           @relation("SurveyTargetSpeaker", fields: [speakerId], references: [id], onDelete: SetNull)
  surveys                     Survey[]
  publicSurveyLinks           PublicSurveyLink[]
  responses                   Response[]
  answerEventIntelligence     AnswerEventIntelligence[]
  answerEventThemes           AnswerEventTheme[]
  answerEventEntities         AnswerEventEntity[]
  answerEventActions          AnswerEventAction[]
  eventIntelligenceAggregates EventIntelligenceAggregate[]
  eventIssueClusters          EventIssueCluster[]
  eventIssueEvidence          EventIssueEvidence[]

  @@unique([eventId, slug])
  @@index([eventId, category])
  @@index([locationId])
  @@index([eventStructureItemId])
  @@index([speakerAssignmentId])
  @@index([eventId, speakerId, category])
}

model Survey {
  id                             String                      @id @default(cuid())
  eventId                        String
  /// Optional while an Advanced Event survey is an unassigned draft. Legacy
  /// and deployed surveys retain their existing canonical SurveyTarget.
  surveyTargetId                 String?
  name                           String
  description                    String?                     @db.Text
  responseMode                   ResponseMode                @default(VOICE_ONLY)
  presentationMode              SurveyPresentationMode      @default(ATTENDEE_CHOOSES)
  status                         EventStatus                 @default(DRAFT)
  ttsProvider                    String?
  ttsVoice                       String?
  ttsLocale                      String?
  settingsJson                   Json?
  /// Stable client-generated key for retry-safe survey creation. Null for
  /// legacy surveys and non-interactive provisioning paths.
  creationRequestId              String?
  availabilityMode               SurveyAvailabilityMode      @default(OPEN_IMMEDIATELY)
  availabilityTimezone           String?
  availabilityOpensAt            DateTime?
  availabilityClosesAt           DateTime?
  availabilityOpenAnchor         SurveyAvailabilityAnchor?
  availabilityCloseAnchor        SurveyAvailabilityAnchor?
  availabilityOpenOffsetMinutes  Int?
  availabilityCloseOffsetMinutes Int?
  availabilityOverride           SurveyAvailabilityOverride?
  /// Organizer-selected Event lifecycle phase. Nullable only for legacy data.
  collectionPhase                CollectionPhase?
  createdAt                      DateTime                    @default(now())
  updatedAt                      DateTime                    @updatedAt

  event                       Event                        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  surveyTarget                SurveyTarget?                @relation(fields: [surveyTargetId], references: [id], onDelete: SetNull)
  questions                   Question[]
  publicSurveyLinks           PublicSurveyLink[]
  responses                   Response[]
  answerEventIntelligence     AnswerEventIntelligence[]
  answerEventThemes           AnswerEventTheme[]
  answerEventEntities         AnswerEventEntity[]
  answerEventActions          AnswerEventAction[]
  eventIntelligenceAggregates EventIntelligenceAggregate[]
  eventIssueClusters          EventIssueCluster[]
  eventIssueEvidence          EventIssueEvidence[]

  @@unique([eventId, creationRequestId])
  @@index([eventId])
  @@index([eventId, collectionPhase])
  @@index([surveyTargetId])
  @@index([availabilityMode])
}

model PublicSurveyLink {
  id                  String    @id @default(cuid())
  surveyId            String
  surveyTargetId      String?
  /// Optional canonical session context for a speaker-survey launch. The
  /// speaker target remains event-wide; this records where the QR/link was
  /// opened from when that detail is available.
  speakerAssignmentId String?
  token               String    @unique
  slug                String?
  isActive            Boolean   @default(true)
  expiresAt           DateTime?
  metadata            Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  survey            Survey                         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  surveyTarget      SurveyTarget?                  @relation(fields: [surveyTargetId], references: [id], onDelete: Restrict)
  speakerAssignment EventSessionSpeakerAssignment? @relation("PublicSurveyLinkSpeakerAssignment", fields: [speakerAssignmentId], references: [id], onDelete: SetNull)
  responses         Response[]

  @@index([surveyId])
  @@index([surveyTargetId])
  @@index([surveyId, surveyTargetId, isActive])
  @@index([isActive])
  @@index([speakerAssignmentId])
}

model Response {
  id                  String  @id @default(cuid())
  eventId             String
  surveyId            String?
  surveyTargetId      String?
  publicSurveyLinkId  String?
  /// Copied from the token's link at launch, so speaker-survey responses can
  /// retain the session that launched them without changing their direct
  /// speaker SurveyTarget.
  speakerAssignmentId String?

  // Response identity (anonymous)
  anonymousId String @default(cuid())

  // Response status
  status ResponseStatus @default(IN_PROGRESS)

  // The method chosen for this attempt. Surveys configured as VOICE_AND_TEXT
  // resolve to VOICE_ONLY or TEXT_ONLY at consent so an attendee's choice is
  // stable for the entire response.
  responseMode ResponseMode @default(VOICE_ONLY)

  /// Snapshot copied from Survey.collectionPhase when the response is created.
  /// A database trigger prevents later mutation. Nullable only for legacy data.
  collectionPhase CollectionPhase?

  // Timestamps
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  // Metadata
  metadata Json? // Device info, user agent, etc.

  // Relations
  event                   Event                          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  survey                  Survey?                        @relation(fields: [surveyId], references: [id], onDelete: SetNull)
  surveyTarget            SurveyTarget?                  @relation(fields: [surveyTargetId], references: [id], onDelete: SetNull)
  publicSurveyLink        PublicSurveyLink?              @relation(fields: [publicSurveyLinkId], references: [id], onDelete: SetNull)
  speakerAssignment       EventSessionSpeakerAssignment? @relation("ResponseSpeakerAssignment", fields: [speakerAssignmentId], references: [id], onDelete: SetNull)
  answers                 Answer[]

// User model for Supabase auth
model User {
  id                     String                  @id // Supabase user.id (uuid)
  email                  String                  @unique
  /// Canonical SignalThread Platform Core user id. Additive and nullable during the
  /// transition; assigned explicitly, never inferred from email. Unique because a
  /// canonical Platform user must resolve to exactly one Pulse user. Pulse keeps its own
  /// primary key (the Pulse Supabase Auth uuid).
  platformUserId         String?                 @unique @db.Uuid
  firstName              String?
  lastName               String?
  role                   UserRole                @default(ADMIN)
  accountId              String? // NULL = SUPER_ADMIN, set = account-scoped
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  account                Account?                @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountMemberships     AccountUserMembership[]
  createdSignupLinks     TestSignupToken[]
  agendaImportsCreated   EventAgendaImportJob[]  @relation("EventAgendaImportCreatedBy")
  agendaImportsConfirmed EventAgendaImportJob[]  @relation("EventAgendaImportConfirmedBy")

  @@index([email])
  @@index([accountId])
  @@index([role])
}

/// Canonical account authorization for regular users. User.accountId remains
/// the primary/default landing account during the multi-account transition.
/// Platform admins intentionally do not require membership rows.
model AccountUserMembership {
  id        String   @id @default(cuid())
  userId    String
  accountId String
  createdAt DateTime @default(now())
  // 20260817160000_add_account_user_memberships created this column as
  // NOT NULL DEFAULT CURRENT_TIMESTAMP, mirroring createdAt. @updatedAt keeps
  // Prisma Client writing the value on every update; @default(now()) is what
  // makes this model match the DDL that is already applied everywhere.
  updatedAt DateTime @default(now()) @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@index([accountId])
  @@index([userId])
}

enum UserRole {
  SUPER_ADMIN // Full system access
  ADMIN // Account-level admin
  MANAGER // Location-level manager
  VIEWER // Read-only access
}

enum PlatformUserActionType {
  OTP_GENERATED
  INVITE_RESENT
  ROLE_CHANGED
  USER_DEACTIVATED
  USER_REACTIVATED
}

model PlatformUserActionAudit {
  id           String                 @id @default(cuid())
  actorUserId  String
  action       PlatformUserActionType
  targetUserId String?
  targetEmail  String
  accountId    String?
  metadata     Json?
  createdAt    DateTime               @default(now())
  account      Account?               @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([targetEmail])
  @@index([accountId, createdAt])
}

// Pending provision records for onboarding flow
model PendingProvision {
  id        String    @id @default(cuid())
  email     String    @unique
  accountId String // Account created for this provision
  /// Role applied when Prisma User is created on first login (account-scoped only).
  role      UserRole  @default(ADMIN)
  firstName String?
  lastName  String?
  createdAt DateTime  @default(now())
  usedAt    DateTime? // NULL = pending, set = used/linked
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([accountId])
  @@index([usedAt])
}

model TestSignupToken {
  id              String    @id @default(cuid())
  tokenHash       String    @unique
  createdByUserId String
  usedAt          DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())

  createdByUser User @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([createdByUserId])
  @@index([usedAt])
  @@index([expiresAt])
}

// Legacy Admin model (deprecated, keeping for backward compatibility)
model Admin {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String
  accountId String? // NULL = global admin, set = account-scoped admin
  role      AdminRole @default(ADMIN)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  account   Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([accountId])
  @@index([role])
}

enum AdminRole {
  SUPER_ADMIN // Full system access
  ADMIN // Account-level admin
  MANAGER // Location-level manager
  VIEWER // Read-only access
}

enum SessionStatus {
  CREATED
  UPLOADING
  UPLOADED
  PROCESSING_TRANSCRIPT
  PROCESSING_ANALYSIS
  COMPLETED
  FAILED
}

enum ProcessingStep {
  UPLOAD
  TRANSCRIBE
  ANALYZE
  TEXT_ENTRY
}

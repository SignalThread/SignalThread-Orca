# ============================================================
# BOOTH AUDIO - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# Copy this file to .env.local for development
# Copy to .env.prod for production (gitignored)
#
# Variables marked with [REQUIRED] must be set manually
# Variables marked with [OPTIONAL] have safe defaults
#
# ============================================================

# ============================================================
# DATABASE
# ============================================================
# [REQUIRED] PostgreSQL connection string
# Development: Local PostgreSQL or Supabase dev instance
# Production: Supabase production or hosted PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/booth_audio?schema=public"

# [OPTIONAL - Production only] Supabase direct connection for Prisma migrations
# Only needed if using Supabase connection pooling
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ============================================================
# OBJECT STORAGE (S3 / MinIO / Cloudflare R2)
# ============================================================
# [REQUIRED] S3-compatible object storage credentials
S3_BUCKET_NAME="booth-audio-recordings"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"

# [OPTIONAL] S3 region (defaults to us-east-1)
S3_REGION="us-east-1"

# [REQUIRED] S3 endpoint
# AWS S3:           https://s3.amazonaws.com
# Cloudflare R2:    https://[account-id].r2.cloudflarestorage.com
# MinIO (local):    http://localhost:9000
S3_ENDPOINT="http://localhost:9000"

# [OPTIONAL] Presigned URL expiration in seconds (default: 300 = 5 minutes)
S3_UPLOAD_EXPIRES_IN=300

# ============================================================
# FILE UPLOAD CONSTRAINTS
# ============================================================
# [OPTIONAL] Maximum file size in bytes (default: 52428800 = 50MB)
MAX_FILE_SIZE_BYTES=52428800

# [OPTIONAL] Allowed audio MIME types (comma-separated)
ALLOWED_MIME_TYPES="audio/webm,audio/mp4,audio/mpeg,audio/wav,audio/ogg"

# ============================================================
# AI SERVICES (OpenAI)
# ============================================================
# [REQUIRED] OpenAI API key for transcription and analysis
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# [OPTIONAL] Transcription service configuration
TRANSCRIPTION_PROVIDER="openai"
TRANSCRIPTION_MODEL="whisper-1"

# [OPTIONAL] Analysis service configuration
ANALYSIS_PROVIDER="openai"
ANALYSIS_MODEL="gpt-4-turbo-preview"
ANALYSIS_PROMPT_VERSION="v1.0"

# ============================================================
# NEXTAUTH (Admin Authentication - NOT YET IMPLEMENTED)
# ============================================================
# [FUTURE] Admin authentication (currently not in use)
# NEXTAUTH_SECRET="your-random-secret-min-32-chars"
# NEXTAUTH_URL="http://localhost:3000"

# ============================================================
# APP CONFIGURATION
# ============================================================
# [AUTO] Node environment (auto-detected, do not change)
NODE_ENV="development"

# [OPTIONAL] Public app URL for absolute URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================================
# STRIPE BILLING
# ============================================================
# Where Stripe redirects if checkout is canceled (public marketing site pricing).
# Checkout success returns to the Voice app via NEXT_PUBLIC_APP_URL.
# Cancel defaults: dev http://localhost:5173 | prod https://www.signalthread.ai
# success -> {NEXT_PUBLIC_APP_URL}/signup/success?session_id={CHECKOUT_SESSION_ID}
# cancel -> {MARKETING_SITE_URL}/#pricing
# MARKETING_SITE_URL="https://www.signalthread.ai"

# [REQUIRED for checkout] Stripe secret key
STRIPE_SECRET_KEY="sk_test_..."

# [REQUIRED for checkout] Stripe Price IDs (plan chosen at checkout: starter | growth)
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_GROWTH="price_..."

# [REQUIRED for webhooks] Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET="whsec_..."

# [OPTIONAL] Enable template demo mode (Events/Retail switcher)
# Auto-enabled in development, requires explicit flag in production
# NEXT_PUBLIC_ENABLE_TEMPLATE_DEMO="true"

# ============================================================
# PROCESSING CONFIGURATION (Advanced - Optional)
# ============================================================
# [OPTIONAL] Maximum retry attempts for failed processing
MAX_PROCESSING_RETRIES=3

# [OPTIONAL] Processing timeout in milliseconds (default: 5 minutes)
PROCESSING_TIMEOUT_MS=300000

# [OPTIONAL] Default booth/event configuration
# DEFAULT_BOOTH_ID="booth-01"
# DEFAULT_CONSENT_VERSION="v1.0"

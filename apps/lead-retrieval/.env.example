NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_AUTH_CALLBACK_URL=https://lr.signalthread.ai/auth/callback

# User-owned Google Workspace OAuth. The redirect URI must exactly match the
# corresponding Google Cloud OAuth client registration for this environment.
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REDIRECT_URI=https://lr.signalthread.ai/api/integrations/google/callback
# Random secret with at least 32 bytes of entropy, used only to sign short-lived OAuth state.
GOOGLE_WORKSPACE_OAUTH_STATE_SECRET=

# User-owned Microsoft 365 (Outlook) OAuth. The redirect URI must exactly match
# the Web redirect registered on the Microsoft Entra app for this environment.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://lr.signalthread.ai/api/integrations/microsoft/callback
# Optional. Random secret with at least 32 bytes of entropy for signing short-lived
# Microsoft OAuth state. Falls back to GOOGLE_WORKSPACE_OAUTH_STATE_SECRET; either
# way the signing key is domain-separated per provider, so state minted for one
# provider can never verify for another.
MICROSOFT_OAUTH_STATE_SECRET=

# Company-owned Pipedrive OAuth. The redirect URI must exactly match the
# callback configured for the Pipedrive app in Developer Hub.
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
PIPEDRIVE_REDIRECT_URI=https://lr.signalthread.ai/api/integrations/pipedrive/callback

# JSON object of base64-encoded 32-byte AES keys, for example {"v1":"..."}.
INTEGRATION_SECRET_ENCRYPTION_KEYS=
INTEGRATION_SECRET_ACTIVE_KEY_ID=v1

# Optional legacy fallbacks when no per-account key is stored in Integrations
PDL_API_KEY=
# Dashboard API key (header X-Api-Key). Bearer in Apollo is for OAuth JWT, not this key.
APOLLO_API_KEY=
# Optional: set to 1 to log key fingerprint (not the secret) on People Match enrichment.
# APOLLO_ENRICHMENT_DEBUG=1

# Optional legacy fallback when no per-company ZoomInfo token is stored in Integrations (same GTM API, Bearer auth).
ZOOMINFO_API_KEY=
ZOOMINFO_BASE_URL=https://api.zoominfo.com/gtm

# Server-only optional badge interpretation. Never expose these through NEXT_PUBLIC_* or EXPO_PUBLIC_*.
BADGE_INTERPRETER_OPENAI_MODEL=gpt-5.6-sol

{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "help:manifest": "node web/scripts/help-docs.mjs --write-manifest",
    "help:generate": "node web/scripts/help-generate.mjs",
    "help:validate": "node web/scripts/help-docs.mjs",
    "help:check": "npm run help:manifest && npm run help:generate && npm run help:validate",
    "help:screenshots": "npm --prefix web run help:screenshots",
    "prisma:seed": "ts-node prisma/seed.ts",
    "test:marketing-email-smoke": "npm --prefix web run test:marketing-email-smoke"
  },
  "dependencies": {
    "@prisma/client": "^7.4.2",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "prisma": "^7.4.2",
    "tailwindcss": "^4.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}

{
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:orca": "npm --workspace apps/orca run dev",
    "dev:platform": "npm --workspace apps/platform run dev",
    "build:orca": "npm --workspace apps/orca run build",
    "build:platform": "npm --workspace apps/platform run build",
    "test:orca": "npm --workspace apps/orca run test:summary",
    "lint:orca": "npm --workspace apps/orca run lint",
    "lint:platform": "npm --workspace apps/platform run lint",
    "typecheck:orca": "npm --workspace apps/orca run typecheck",
    "typecheck:platform": "npm --workspace apps/platform run typecheck",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:summary --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run test",
    "boundaries": "node scripts/check-import-boundaries.mjs",
    "help:manifest": "node apps/orca/scripts/help-docs.mjs --write-manifest",
    "help:generate": "node apps/orca/scripts/help-generate.mjs",
    "help:validate": "node apps/orca/scripts/help-docs.mjs",
    "help:check": "npm run help:manifest && npm run help:generate && npm run help:validate",
    "help:screenshots": "npm --workspace apps/orca run help:screenshots",
    "prisma:seed": "npm --workspace apps/orca run prisma:seed",
    "test:marketing-email-smoke": "npm --workspace apps/orca run test:marketing-email-smoke"
  },
  "dependencies": {
    "@prisma/client": "^7.4.2",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "prisma": "^7.4.2",
    "tailwindcss": "^4.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "name": "signalthread"
}
